define_attribute {p:reset_in} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:reset_in} {PAP_IO_LOC} {C22}
define_attribute {p:reset_in} {PAP_IO_VCCIO} {3.3}
define_attribute {p:reset_in} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:reset_in} {PAP_IO_NONE} {TRUE}

define_attribute {p:key} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:key} {PAP_IO_LOC} {C23}
define_attribute {p:key} {PAP_IO_VCCIO} {3.3}
define_attribute {p:key} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:key} {PAP_IO_NONE} {TRUE}

create_clock -name board_clk -period 37.037037 [get_ports {clk_in}]
# Ratio/period are inferred from the real GPLL configuration.
create_generated_clock -name system_clk [get_pins {u_clock.u_gpll/CLKOUT0}]

# The CP210x UART and push-buttons have no synchronous relation to board_clk.
# UART rx_meta->rx_sync and gpio_meta->gpio_sync remain timed reg-to-reg.
# reset_in asserts reset asynchronously; release uses reset_pipe (two clocks).
set_false_path -from [get_ports {uart_rx}]
set_false_path -from [get_ports {key}]
set_false_path -from [get_ports {reset_in}]
# LED/PWM/UART TX are asynchronous status outputs without a specified receiver
# sampling clock. Do not invent numeric output delays or claim full IO closure.
